{
  "name": "weather",
  "version": "1.0.0",
  "source": "registry.hanbit.example/mcp/weather",
  "transport": "stdio",
  "command": "npx -y @hanbit/weather-mcp@1.0.0",
  "permissions": {"network": ["api.weather.example"], "files": [], "env": ["WEATHER_API_KEY"]},
  "tools": [
    {
      "name": "get_forecast",
      "description": "도시 이름을 받아 3일 날씨 예보를 돌려준다.",
      "inputSchema": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}
    }
  ]
}
